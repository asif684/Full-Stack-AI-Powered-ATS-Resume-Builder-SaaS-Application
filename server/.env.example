# Database
DATABASE_URL="postgresql://resume_builder:resume_builder_dev@localhost:5432/resume_builder?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production-at-least-32-chars-long"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Encryption key for API keys (32 characters)
ENCRYPTION_KEY="your-32-char-encryption-key-here!!"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Rate limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# Default LLM provider (for system prompt option)
DEFAULT_LLM_PROVIDER="groq"
DEFAULT_LLM_MODEL="llama-3.1-8b-instant"

# System API keys (for "System Prompt" option - no user key needed)
# You can leave these empty if you want users to always provide their own keys
SYSTEM_OPENAI_KEY="")
SYSTEM_ANTHROPIC_KEY="")
SYSTEM_GEMINI_KEY="")
SYSTEM_GROQ_KEY="")
SYSTEM_CEREBRAS_KEY="")
SYSTEM_TOGETHER_KEY="")
SYSTEM_OPENROUTER_KEY="")
SYSTEM_NVIDIA_KEY="")
SYSTEM_GROK_KEY="")